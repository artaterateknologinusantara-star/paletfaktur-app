<?xml version="1.0" encoding="utf-8"?>
<!-- Template web.config untuk IIS virtual application "pallet" (https://demo.arunapps.com/pallet/).
     Disalin ke C:\inetpub\ArunaPallet oleh deploy-pallet.ps1 setelah setiap `dotnet publish`. Tanpa secret. -->
<configuration>
  <system.webServer>
    <handlers>
      <remove name="aspNetCore" />
      <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
    </handlers>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="15728640" />
      </requestFiltering>
    </security>
    <aspNetCore processPath="dotnet" arguments=".\PaletFaktur.Api.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
      <environmentVariables>
        <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
      </environmentVariables>
    </aspNetCore>
    <rewrite>
      <rules>
        <clear />
        <rule name="RedirectToHttps" stopProcessing="true">
          <match url=".*" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}{REQUEST_URI}" redirectType="Permanent" />
        </rule>
        <!-- API dan file upload ditangani ASP.NET Core. -->
        <rule name="SkipApi" stopProcessing="true">
          <match url="^(api/.*|uploads/.*)$" />
          <action type="None" />
        </rule>
        <rule name="ReverseProxyRoot" stopProcessing="true">
          <match url="^$" />
          <action type="Rewrite" url="http://localhost:4030/pallet" />
        </rule>
        <rule name="ReverseProxyToFrontend" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://localhost:4030/pallet/{R:1}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
