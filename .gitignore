# --- Backend (.NET) ---
**/bin/
**/obj/
*.user

# Config dengan secret asli (connection string, JWT key) — jangan ikut ter-commit.
# appsettings.json (base) TETAP disertakan, isinya sudah pakai nilai placeholder.
**/appsettings.Development.json
**/appsettings.Production.json

# File yang diupload user (logo perusahaan) — jangan ikut di-commit, tapi folder tetap ada lewat .gitkeep
backend/PaletFaktur.Api/wwwroot/uploads/*
!backend/PaletFaktur.Api/wwwroot/uploads/.gitkeep

# --- Frontend (Node / Next.js) ---
**/node_modules/
**/.next/
**/.env.local
*.tsbuildinfo

# --- OS / Editor ---
.DS_Store
**/.DS_Store
.vscode/
.idea/

# --- Mobile (Capacitor / Android) ---
mobile/node_modules/
mobile/out/
mobile/android/app/build/
mobile/android/.gradle/
mobile/android/local.properties
# Hasil build Android apa pun, di folder mana pun
*.apk
*.aab
# Keystore penandatanganan release — JANGAN pernah ikut ter-commit (password dipegang pemilik)
*.jks
*.keystore
