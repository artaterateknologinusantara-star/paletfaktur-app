{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=CHANGE_THIS_HOST,1433;Database=PaletFakturDb;User Id=CHANGE_THIS_USER;Password=CHANGE_THIS_PASSWORD;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Issuer": "PaletFaktur.Api",
    "Audience": "PaletFaktur.Client",
    "Key": "CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS",
    "ExpiryMinutes": 480
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  }
}
